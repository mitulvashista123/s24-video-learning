# copy to terraform.tfvars (git-ignored) and adjust
aws_region      = "ap-south-1"
project_name    = "s24-video"
gitops_repo_url = "https://github.com/<github-user>/s24-video-learning.git"
# private repository only:
# gitops_repo_username = "<github-user>"
# gitops_repo_token    = "<personal-access-token>"
# second apply, after observability/setup-commands.sh printed it:
# loki_push_url = "http://internal-xxxx.ap-south-1.elb.amazonaws.com/loki/api/v1/push"
